# Database (required) — Supabase Postgres connection string.
# Get it from your Supabase project: Settings -> Database -> Connection string
# (use the "URI" / "Transaction pooler" form, port 6543).
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xxxxx.pooler.supabase.com:6543/postgres

# API Keys (required)
CLAUDE_API_KEY=your_key_here
ELEVENLABS_API_KEY=your_key_here

# Optional: override the narration voice (default is "Alice", a premade voice
# available on every ElevenLabs plan; list voices at GET /v1/voices)
ELEVENLABS_VOICE_ID=

# Optional: better stock photos (free key from https://www.pexels.com/api/)
# Without it, images fall back to Openverse and Wikimedia Commons (no key needed).
PEXELS_API_KEY=

# Optional: only needed if RENDER_MODE=fal
FAL_API_KEY=

# Rendering: "local" (default - images from the web + ffmpeg compositing)
# or "fal" (hand off rendering to a fal.ai model)
RENDER_MODE=local

# PayPal Subscriptions (required for paid-plan checkout on the Pricing page).
# Get sandbox credentials at https://developer.paypal.com/dashboard/applications/sandbox
# — note the /sandbox in that URL; the /live tab issues different, real-money
# credentials. Set PAYPAL_MODE=live only once you're ready to accept real cards.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Resend (transactional email — required for password reset + Contact Us).
# Get an API key at https://resend.com/api-keys. Until you verify your own
# sending domain with Resend, RESEND_FROM_EMAIL must stay on their shared
# onboarding@resend.dev address (verified domains can use anything @yourdomain).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Explainer Studio <onboarding@resend.dev>
SUPPORT_EMAIL=support@explainerstudio.org

# Google Sign-In (optional — the button just stays disabled without these).
# Create an OAuth client at https://console.cloud.google.com -> APIs & Services
# -> Credentials -> Create Credentials -> OAuth client ID -> Web application.
# Add BACKEND_URL + /api/auth/google/callback as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origin the frontend runs at — PayPal and Google redirect the buyer/user back
# here after checkout or sign-in.
FRONTEND_URL=http://localhost:5173
# Origin the backend runs at — used to build the Google OAuth callback URL.
BACKEND_URL=http://localhost:5000

# Server
PORT=5000
NODE_ENV=development
VIDEO_STORAGE_PATH=./videos
