# Production .env for the Droplet — copy this to /var/www/explainerstudio/.env
# and fill in real values, then: chown www-data:www-data /var/www/explainerstudio/.env
#
# Same keys as the local .env.example, just with production URLs. Copy your
# real API keys over from your local .env — they don't need to change.

SUPABASE_DB_URL=

CLAUDE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

PEXELS_API_KEY=
FAL_API_KEY=
RENDER_MODE=local

# Switch to PAYPAL_MODE=live + live credentials only when ready to accept
# real payments. Keep using Sandbox credentials until then.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IMPORTANT: these must be the real domain, not localhost, and must use
# https:// once certbot has issued the certificate (see deploy/setup.sh).
# Before that, use http:// — you'll need to update this and restart the
# service (systemctl restart explainer-backend) right after running certbot.
FRONTEND_URL=https://explainerstudio.org
BACKEND_URL=https://explainerstudio.org

PORT=5000
NODE_ENV=production
VIDEO_STORAGE_PATH=./videos
